# ============================================================================
# Variables de entorno — Pragma Studio SaaS (Fase 1)
# Copiá a .env (NO commitear .env) y completá con tu proyecto Supabase NUEVO.
# ============================================================================

# --- Frontend (Vite · expuestas al navegador: sólo claves públicas) ---
# Proyecto Supabase NUEVO (base compartida, tablas con prefijo ps_).
VITE_SUPABASE_URL=https://XXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...   # anon public key (segura si la RLS es restrictiva)

# --- Backend serverless (Vercel · NUNCA en el frontend) ---
# Service role key: valida JWT y lee ps_memberships / ps_org_fiscal_config con bypass RLS.
SUPABASE_URL=https://XXXXXXXX.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...     # service_role key (secreta)

# Prefijo de tablas (debe coincidir con las migraciones y src/core/db.js).
PS_TABLE_PREFIX=ps_

# --- AFIP (Fase 1: credencial global de la organización #1 / Pragma, fallback) ---
# En fases siguientes, cert/key se guardan cifrados por organización en ps_org_fiscal_config.
AFIP_CUIT=20424402142
AFIP_POINT_OF_SALE=3
AFIP_CERT=<cert PEM en base64>
AFIP_KEY=<key PEM en base64>
AFIP_PRODUCTION=false                  # 'true' = AFIP real; 'false' = homologación
# AFIP_SDK_TOKEN=<token opcional de app.afipsdk.com>
